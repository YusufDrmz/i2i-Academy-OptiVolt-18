# ── PostgreSQL ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/optivolt
DB_USERNAME=optivolt_user
DB_PASSWORD=your_secure_password

# ── Apache Kafka ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Apache Ignite ───────────────────────────────────────────
IGNITE_ADDRESS=localhost:10800

# ── Google Gemini ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── E-posta (Gmail App Password) ────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── İş Kuralları ────────────────────────────────────────────
PENALTY_RATE_MULTIPLIER=2.0
ALERT_DAILY_MAX=3
